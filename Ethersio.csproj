<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet build Ethersio.csproj -c Release : fonctionne sous Windows, macOS et Linux. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Ethersio</AssemblyName>
    <RootNamespace>Ethersio</RootNamespace>
    <ApplicationIcon>src\Ethersio.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/VERSION.txt').Trim())</AppVersion>
    <Version>$(AppVersion)</Version>
    <Product>Ethersio</Product>
    <AssemblyTitle>Ethersio</AssemblyTitle>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <!-- AppInfo.Version vient de VERSION.txt : une seule source pour l'exe, l'installeur et la signature -->
  <Target Name="GenerateAppInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <AppInfoFile>$(IntermediateOutputPath)AppInfo.g.cs</AppInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(AppInfoFile)" Lines="namespace Ethersio { static class AppInfo { public const string Version = &quot;$(AppVersion)&quot;%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(AppInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
